# =============================================================================
# MindLens Backend — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   PowerShell: Copy-Item .env.example .env
# =============================================================================

# --- Server -------------------------------------------------------------------
# Port the Express server listens on.
PORT=5000

# development | production
NODE_ENV=development

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Vite's dev server default is 5173. Add your deployed frontend URL in production.
FRONTEND_URL=http://localhost:5173

# --- Upload limits ------------------------------------------------------------
# Maximum advertisement image size in megabytes.
MAX_UPLOAD_MB=5

# --- Gemini (Milestone 2) -----------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# Leave empty until Milestone 2 — the server starts fine without it.
GEMINI_API_KEY=

# Verify this model is still available at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
