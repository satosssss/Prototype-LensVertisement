# =============================================================================
# MindLens Backend — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   PowerShell: Copy-Item .env.example .env
# =============================================================================

# --- Server -------------------------------------------------------------------
# Port the Express server listens on.
PORT=5000

# development | production
NODE_ENV=development

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Vite's dev server default is 5173. Add your deployed frontend URL in production.
FRONTEND_URL=http://localhost:5173

# --- Upload limits ------------------------------------------------------------
# Maximum advertisement image size in megabytes.
MAX_UPLOAD_MB=5

# --- Gemini (free tier) -------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# The server boots without it, but every analysis request will fail with a
# clear 502 until it is set.
GEMINI_API_KEY=

# `gemini-3.8-flash` is the current stable Flash model AND the model whose
# input and output are both listed as "free of charge" on
# https://ai.google.dev/gemini-api/docs/pricing
# Do NOT switch to `gemini-4-argon`: it is a paid model.
# Check availability at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Hard deadline for one AI call, in milliseconds.
GEMINI_TIMEOUT_MS=60000

# Optional thinking budget: MINIMAL | LOW | MEDIUM | HIGH.
# Leave empty by default — some models reject levels they do not support, and
# a failed request is worse than a slightly slower one.
GEMINI_THINKING_LEVEL=

# Ceiling on response tokens. Structured output that gets truncated is unusable.
GEMINI_MAX_OUTPUT_TOKENS=4096

# --- Free-tier caveats you must disclose -------------------------------------
# 1. Cost: this integration is built for the free tier, so there is no bill.
# 2. Rate limits: requests per minute and per day are capped per project and
#    reset at midnight Pacific. Check your project's actual limits at
#    https://aistudio.google.com/rate-limit (they are not published as fixed
#    numbers). Exhausting them returns HTTP 429 from this API.
# 3. Data use: on the FREE tier Google's pricing page states submitted content
#    is "Used to improve our products: Yes". The paid tier says "No". Do not
#    upload advertisements containing personal data, and say this plainly in
#    the project write-up and the About page.

