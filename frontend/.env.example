# =============================================================================
# MindLens Frontend — environment template
# Copy to `.env` and edit. Only VITE_* variables reach the browser bundle,
# so NEVER put an API key or secret in this file.
# =============================================================================

# Base URL of the MindLens backend.
# Leave EMPTY during local development — Vite proxies /api to localhost:5000
# (see vite.config.js), which avoids CORS entirely.
#
# In production, set this to your deployed backend, e.g.:
#   VITE_API_BASE_URL=https://mindlens-api.onrender.com
VITE_API_BASE_URL=
